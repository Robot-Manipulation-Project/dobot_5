<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="example2robot">

  <xacro:property name="Plate" value="0.3" />
  <xacro:property name="PlateThickness" value="0.01" />
  
  <xacro:property name="L0" value="0.3" />
  <xacro:property name="L0width" value="0.03" />
  <xacro:property name="L0height" value="0.35" />
  <xacro:property name="L1" value="0.20" />
  <xacro:property name="L1width" value="0.03" />
  <xacro:property name="L2" value="0.08" />
  <xacro:property name="L2width" value="0.03" />
  <xacro:property name="L3" value="0.08" />
  <xacro:property name="L3width" value="0.015" />

  <xacro:property name="EndEffector" value="0.04" />

  <xacro:property name="J1MIN" value="-0.1" />
  <xacro:property name="J1MAX" value="0.1" />
  <xacro:property name="J2MIN" value="-0.07" />
  <xacro:property name="J2MAX" value="0.07" />
  <xacro:property name="J3MIN" value="-0.05" />
  <xacro:property name="J3MAX" value="0.05" />

  <material name="blue">
    <color rgba="0.2 0.4 0.65 1" />
  </material>

  <material name="yellow">
    <color rgba="1 0.85 0 1" />
  </material>

  <link name="world" />

  <link name="plate">
    <visual name="plate">
      <origin xyz="${Plate/2} 0 0" />
      <geometry>
        <box size="${Plate} ${Plate} ${PlateThickness}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="link0">
    <visual name="link0">
      <origin xyz="${L0width/2} 0 ${(L0/2)-L0height}" rpy="0 0 0" />
      <geometry>
        <box size="${L0width} ${L0width} ${L0}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="link1">
    <visual name="link1">
      <origin xyz="0 ${-L1/2} 0" rpy="0 0 ${pi/2}" />
      <geometry>
        <box size="${L1} ${L1width} ${L1width}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>



  <link name="link2">
    <visual name="link2">
      <origin xyz="0 ${L2/2} 0" rpy="0 0 ${pi/2}"  />
      <geometry>
        <box size ="${L2} ${L2width} ${L2width}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="link3">
    <visual name="link3">
      <origin xyz="0 ${L3/2} 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <box size="${L3} ${L3width} ${L3width}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="ee">
    <visual name="ee">
      <origin xyz="0 0 0" />
      <geometry>
        <box size="${EndEffector} ${EndEffector} ${EndEffector}" />
      </geometry>
      <material name="yellow" />
    </visual>
  </link>

  <joint name="plate_in_world" type="fixed">
    <parent link="world" />
    <child link="plate" />
    <origin xyz="${-(L1)} 0 0" rpy="0 0 0" />
  </joint>

  <joint name="link0" type="fixed">
    <parent link="plate" />
    <child link="link0" />
    <origin xyz="0 0 ${L0height}" rpy="0 0 0" />
  </joint>

  <joint name="joint1" type="prismatic">
    <parent link="link0" />
    <child link="link1" />
    <origin xyz="0 0 -0.1" rpy="0 0 ${pi/2}" />
    <axis xyz="0 0 1" />
    <limit lower="${J1MIN}" upper="${J1MAX}" effort="1" velocity="1" />
  </joint>

  <joint name="joint2" type="prismatic">
    <parent link="link1" />
    <child link="link2" />
    <origin xyz="${L1} 0 0" rpy="${-pi/2} ${-pi/2} ${-pi/2}" />
    <axis xyz="0 0 1" />
    <limit lower="${J2MIN}" upper="${J2MAX}" effort="1" velocity="1" />
  </joint>

  <joint name="joint3" type="prismatic">
    <parent link="link2" />
    <child link="link3" />
    <origin xyz="0 ${L2} 0" rpy="${-pi/2} 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="${J3MIN}" upper="${J3MAX}" effort="1" velocity="1" />
  </joint>

  <joint name="end_effector" type="fixed">
    <parent link="link3" />
    <child link="ee" />
    <origin xyz="0 0 ${L3+(EndEffector/2)}" rpy="0 0 0" />
  </joint>

</robot>

